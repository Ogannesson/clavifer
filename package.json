{
  "name": "clavifer",
  "version": "0.5.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist/worker",
    "db:local": "wrangler d1 migrations apply clavifer-local --local",
    "deploy": "tsx scripts/deploy.mjs",
    "test:e2e": "npm run build && go test -c -o work/clavifer-integration.test.exe ./cmd/clavifer && node scripts/e2e-local.mjs && tsx scripts/e2e-backup.mjs && tsx scripts/e2e-origin-change.mjs",
    "test:cli": "go test ./...",
    "test:system": "npm run build:cli && node scripts/e2e-cli-system.mjs",
    "test:hosts": "npm run build && go test -c -o work/clavifer-integration.test.exe ./cmd/clavifer && node scripts/e2e-local.mjs --hosts",
    "build:cli": "go build -trimpath -o dist/clavifer.exe ./cmd/clavifer",
    "preview:test": "node scripts/preview-test.mjs",
    "openapi:generate": "tsx scripts/generate-openapi.mjs",
    "openapi:check": "tsx scripts/generate-openapi.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@better-auth/oauth-provider": "1.7.4",
    "@better-auth/passkey": "1.7.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "age-encryption": "0.3.1",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
